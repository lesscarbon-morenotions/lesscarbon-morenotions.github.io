---
/**
 * William Morris–style willow field: greener, more present tiles + soft veil.
 * Pure decoration — hidden from assistive tech.
 */
---

<div class="willow-backdrop" aria-hidden="true">
  <div class="willow-layer willow-layer--green"></div>
  <div class="willow-layer willow-layer--deep"></div>
  <div class="willow-veil"></div>
  <div class="willow-glow willow-glow--tl"></div>
  <div class="willow-glow willow-glow--br"></div>
</div>

<style>
  .willow-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: #e8efe4;
  }

  .willow-layer {
    position: absolute;
    inset: -25%;
    background-repeat: repeat;
    will-change: transform;
  }

  /* Dominant green willow (classic deep Morris) */
  .willow-layer--green {
    background-image: url('/media/patterns/willow-morris-deep.jpg');
    background-size: 360px 360px;
    opacity: 0.48;
    animation: willow-pan-a 90s linear infinite;
    filter: saturate(1.15) contrast(1.02) hue-rotate(-4deg);
  }

  /* Secondary sage/blue-accent willow for depth */
  .willow-layer--deep {
    background-image: url('/media/patterns/willow-morris.jpg');
    background-size: 480px 480px;
    opacity: 0.22;
    mix-blend-mode: multiply;
    animation: willow-pan-b 140s linear infinite reverse;
    filter: saturate(1.05) brightness(0.95);
  }

  /* Lighter veil so willows read more clearly (less “transparent wash”) */
  .willow-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        165deg,
        rgba(244, 248, 242, 0.42) 0%,
        rgba(232, 239, 228, 0.32) 45%,
        rgba(236, 242, 234, 0.4) 100%
      ),
      radial-gradient(ellipse 70% 50% at 15% 0%, rgba(122, 154, 109, 0.14), transparent 55%),
      radial-gradient(ellipse 60% 45% at 100% 10%, rgba(63, 90, 56, 0.08), transparent 50%);
  }

  .willow-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.4;
    animation: willow-pulse 12s ease-in-out infinite;
  }

  .willow-glow--tl {
    top: -8%;
    left: -4%;
    width: min(48vw, 28rem);
    height: min(48vw, 28rem);
    background: radial-gradient(circle, rgba(122, 154, 109, 0.4), transparent 70%);
  }

  .willow-glow--br {
    right: -6%;
    bottom: -10%;
    width: min(52vw, 30rem);
    height: min(52vw, 30rem);
    background: radial-gradient(circle, rgba(63, 90, 56, 0.22), transparent 70%);
    animation-delay: -4s;
  }

  @keyframes willow-pan-a {
    0% {
      transform: translate3d(0, 0, 0) rotate(0.001deg);
    }
    100% {
      transform: translate3d(-180px, -90px, 0) rotate(0.001deg);
    }
  }

  @keyframes willow-pan-b {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(120px, -150px, 0);
    }
  }

  @keyframes willow-pulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.48;
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .willow-layer--green,
    .willow-layer--deep,
    .willow-glow {
      animation: none !important;
    }
  }

  @media (max-width: 640px) {
    .willow-layer--green {
      background-size: 260px 260px;
      opacity: 0.42;
    }
    .willow-layer--deep {
      background-size: 340px 340px;
      opacity: 0.18;
    }
  }
</style>
