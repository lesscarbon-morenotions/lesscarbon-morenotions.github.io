---
import SearchBox from '../blog/SearchBox';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/blog/tags/', label: 'Tags' },
  { href: '/about/', label: 'About' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-beluga-200/70 bg-beluga-50/80 backdrop-blur-md">
  <div class="site-container flex flex-wrap items-center justify-between gap-4 py-3">
    <a href="/" class="group flex items-center gap-3 no-underline" transition:name="site-logo">
      <span class="relative grid h-10 w-10 place-items-center overflow-hidden rounded-full bg-gradient-to-br from-hydrangea-300 to-cornflower-400 shadow-inner">
        <svg viewBox="0 0 40 40" class="h-7 w-7 text-white" aria-hidden="true">
          <ellipse cx="20" cy="22" rx="11" ry="8" fill="currentColor" opacity="0.95" />
          <circle cx="24" cy="20" r="1.3" fill="#1c242c" />
          <path d="M8 14c4-6 12-8 18-4" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.7" />
        </svg>
      </span>
      <span>
        <span class="block font-display text-lg font-semibold leading-tight text-ink group-hover:text-hydrangea-700">
          Less Carbon
        </span>
        <span class="block text-xs font-medium tracking-wide text-muted">more notions</span>
      </span>
    </a>

    <nav aria-label="Primary" class="flex flex-wrap items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-full px-3 py-1.5 text-sm font-semibold no-underline transition',
              isActive(link.href)
                ? 'bg-hydrangea-200/80 text-hydrangea-700'
                : 'text-beluga-700 hover:bg-white/80 hover:text-ink',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="w-full sm:w-auto sm:min-w-[14rem]">
      <SearchBox client:load />
    </div>
  </div>
</header>
