---
import SearchBox from '../blog/SearchBox';
import CloudLogo from '../ui/CloudLogo.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/blog/tags/', label: 'Tags' },
  { href: '/about/', label: 'About' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header sticky top-0 z-40 border-b border-moss-700/15">
  <div class="site-header__willow" aria-hidden="true"></div>
  <div class="site-header__shade" aria-hidden="true"></div>
  <div class="site-container relative z-10 flex flex-wrap items-center justify-between gap-4 py-3">
    <a href="/" class="group flex items-center gap-3 no-underline" transition:name="site-logo">
      <CloudLogo size={42} animated={true} />
      <span>
        <span class="block font-display text-lg font-semibold leading-tight text-ink group-hover:text-moss-700">
          Less Carbon
        </span>
        <span class="block text-xs font-medium tracking-wide text-muted">more notions</span>
      </span>
    </a>

    <nav aria-label="Primary" class="flex flex-wrap items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-full px-3 py-1.5 text-sm font-semibold no-underline transition',
              isActive(link.href)
                ? 'bg-moss-700/15 text-moss-700'
                : 'text-beluga-700 hover:bg-white/70 hover:text-ink',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="w-full sm:w-auto sm:min-w-[14rem]">
      <SearchBox client:load />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    isolation: isolate;
  }

  /* Different willow shade from page body: cooler moss, denser tile, more present */
  .site-header__willow {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/media/patterns/willow-morris-deep.jpg');
    background-size: 220px 220px;
    background-repeat: repeat;
    opacity: 0.55;
    filter: saturate(1.2) brightness(0.92) hue-rotate(-8deg) contrast(1.05);
  }

  .site-header__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(232, 239, 228, 0.78) 0%,
      rgba(244, 248, 242, 0.72) 100%
    );
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: inset 0 -1px 0 rgba(63, 90, 56, 0.08);
  }
</style>
