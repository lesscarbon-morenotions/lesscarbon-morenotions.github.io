---
import PostCard from '../blog/PostCard.astro';
import { getFeaturedPosts } from '../../utils/posts';

const featured = await getFeaturedPosts(6);
---

<section class="site-container py-10 sm:py-14">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div class="glass-panel-soft px-5 py-4 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-moss-700">From the archive</p>
      <h2 class="mt-1 font-display text-3xl font-semibold tracking-tight text-ink">Latest posts</h2>
    </div>
    <a href="/blog/" class="btn-ghost text-sm">Browse all posts</a>
  </div>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((post, i) => <PostCard post={post} priority={i === 0} />)}
  </div>
</section>
