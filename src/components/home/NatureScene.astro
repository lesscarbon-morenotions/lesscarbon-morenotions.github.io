---
// Decorative CSS/SVG nature layer over hero image
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <!-- Floating butterfly (CSS) -->
  <div class="animate-float absolute right-[8%] top-[12%] h-12 w-12 opacity-90">
    <img
      src="/media/nature/butterfly.jpg"
      alt=""
      class="animate-flutter h-full w-full rounded-full object-cover shadow-lg ring-2 ring-white/70"
      width="48"
      height="48"
      loading="lazy"
    />
  </div>

  <!-- Soft hydrangea accent -->
  <div class="animate-float-slow absolute bottom-[10%] left-[6%] h-16 w-16 opacity-85">
    <img
      src="/media/nature/hydrangea-cornflowers.jpg"
      alt=""
      class="h-full w-full rounded-2xl object-cover shadow-md ring-2 ring-white/60"
      width="64"
      height="64"
      loading="lazy"
    />
  </div>

  <!-- SVG cornflower drifting -->
  <svg
    class="animate-float absolute bottom-[18%] right-[12%] h-10 w-10 text-cornflower-400 drop-shadow"
    viewBox="0 0 64 64"
    fill="currentColor"
  >
    <circle cx="32" cy="32" r="6" class="text-butterfly-gold" fill="#d4a84b" />
    <ellipse cx="32" cy="16" rx="8" ry="12" opacity="0.9" />
    <ellipse cx="32" cy="48" rx="8" ry="12" opacity="0.9" />
    <ellipse cx="16" cy="32" rx="12" ry="8" opacity="0.9" />
    <ellipse cx="48" cy="32" rx="12" ry="8" opacity="0.9" />
    <ellipse cx="20" cy="20" rx="9" ry="7" transform="rotate(-40 20 20)" opacity="0.75" />
    <ellipse cx="44" cy="20" rx="9" ry="7" transform="rotate(40 44 20)" opacity="0.75" />
    <ellipse cx="20" cy="44" rx="9" ry="7" transform="rotate(40 20 44)" opacity="0.75" />
    <ellipse cx="44" cy="44" rx="9" ry="7" transform="rotate(-40 44 44)" opacity="0.75" />
  </svg>

  <!-- Subtle vignette -->
  <div class="absolute inset-0 bg-gradient-to-tr from-beluga-900/10 via-transparent to-hydrangea-500/10"></div>
</div>
