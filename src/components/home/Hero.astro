---
import { Image } from 'astro:assets';
import heroImg from '../../assets/images/hero-beluga-hydrangea.jpg';
import NatureScene from './NatureScene.astro';
---

<section class="relative overflow-hidden">
  <div class="site-container grid items-center gap-10 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:py-20">
    <div class="relative z-10">
      <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-moss-700/20 bg-white/75 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-moss-700">
        <span class="h-1.5 w-1.5 rounded-full bg-moss-400"></span>
        Sustainability · Slow living
      </p>
      <h1 class="font-display text-4xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-5xl lg:text-6xl">
        Less carbon,
        <span class="block bg-gradient-to-r from-moss-700 via-cornflower-600 to-hydrangea-500 bg-clip-text text-transparent">
          more notions
        </span>
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
        Notes on living lightly — refill culture, local shops, and the small practices that
        lighten our footprint and widen our ideas.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="/blog/">Read the blog</a>
        <a class="btn-ghost" href="/about/">Meet the author</a>
      </div>
    </div>

    <div class="relative">
      <div class="hero-gradient-mesh absolute -inset-6 -z-10 rounded-[2.5rem] opacity-70 blur-2xl"></div>
      <div class="card relative aspect-[4/3] overflow-hidden">
        <Image
          src={heroImg}
          alt="A calm nature scene with soft blues and floating blooms"
          class="h-full w-full object-cover"
          widths={[480, 720, 960]}
          sizes="(max-width: 768px) 100vw, 520px"
          loading="eager"
          fetchpriority="high"
        />
        <NatureScene />
      </div>
    </div>
  </div>
</section>
