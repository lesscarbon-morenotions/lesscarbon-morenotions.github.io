---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import TagFilter from '../../components/blog/TagFilter';
import { getPublishedPosts } from '../../utils/posts';
import { collectTags } from '../../utils/tags';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout
  title="Blog"
  description="Posts from Less Carbon, More Notions — sustainability, refill culture, and living lightly."
>
  <section class="site-container py-12">
    <header class="mb-8 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-hydrangea-700">Archive</p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-ink">All notions</h1>
      <p class="mt-3 text-muted">
        Filter by tag, search from the header, or open any card for a calm reading experience.
      </p>
    </header>

    <div class="mb-8">
      <TagFilter client:load tags={tags} />
    </div>

    <p id="filter-empty" class="mb-6 hidden rounded-2xl border border-beluga-200 bg-white/70 px-4 py-3 text-sm text-muted" hidden>
      No posts match those tags. Try clearing a filter.
    </p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
