---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import TagFilter from '../../components/blog/TagFilter';
import { getPublishedPosts } from '../../utils/posts';
import { collectTags } from '../../utils/tags';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout
  title="Blog"
  description="Posts from Less Carbon, More Notions — sustainability, refill culture, and living lightly."
>
  <section class="site-container py-12 sm:py-14">
    <header class="page-header">
      <p class="eyebrow">Archive</p>
      <h1>All notions</h1>
      <p class="lede">
        Essays and Instagram field notes. Filter by tag, search from the header, or open any card.
        The Instagram badge marks notes imported from
        <a
          href="https://www.instagram.com/lesscarbon.morenotions/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-ink"
        >@lesscarbon.morenotions</a>.
      </p>
    </header>

    <div class="glass-panel-soft mb-8 p-4 sm:p-5">
      <TagFilter client:load tags={tags} />
    </div>

    <p
      id="filter-empty"
      class="mb-6 rounded-2xl border border-beluga-200 bg-white/90 px-4 py-3 text-sm text-muted shadow-sm"
      hidden
    >
      No posts match those tags. Try clearing a filter.
    </p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
