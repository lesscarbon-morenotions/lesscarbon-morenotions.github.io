---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/dates';
import { readingTime } from '../../utils/posts';
import { slugifyTag } from '../../utils/tags';
import InstagramLink from '../../components/ui/InstagramLink.astro';
import InstagramIcon from '../../components/ui/InstagramIcon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const cover = post.data.cover ?? '/media/brand/og-default.jpg';
const fromIg = post.data.source === 'instagram';
const sourceUrl = post.data.sourceUrl;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={cover}
>
  <article class="pb-20" data-pagefind-body>
    <header class="relative">
      <div class="relative aspect-[21/9] min-h-[240px] w-full overflow-hidden bg-beluga-100">
        <img
          src={cover}
          alt={post.data.coverAlt ?? `Cover image for ${post.data.title}`}
          class="h-full w-full object-cover"
          width="1400"
          height="600"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-beluga-900/60 via-beluga-900/20 to-transparent"></div>
      </div>
      <div class="site-container relative -mt-28">
        <div class="glass-panel max-w-3xl p-6 sm:p-9">
          <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(post.body)}</span>
            {
              fromIg && (
                <>
                  <span aria-hidden="true">·</span>
                  <span class="inline-flex items-center gap-1.5 font-medium text-ink">
                    <InstagramIcon size={14} />
                    From Instagram
                  </span>
                </>
              )
            }
          </div>
          <h1 class="mt-3 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl" data-pagefind-meta="title">
            {post.data.title}
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-muted">{post.data.description}</p>
          <div class="mt-6 flex flex-wrap items-center gap-2">
            {
              post.data.tags.map((tag) => (
                <a class="tag-pill" href={`/blog/tags/${slugifyTag(tag)}/`}>
                  {tag}
                </a>
              ))
            }
            {sourceUrl && <InstagramLink href={sourceUrl} class="!py-1" />}
          </div>
        </div>
      </div>
    </header>

    <div class="site-container mt-8">
      <div class="glass-panel mx-auto max-w-3xl px-6 py-8 sm:px-10 sm:py-12">
        <div class="prose-nature mx-auto max-w-2xl">
          <Content />
        </div>

        <nav
          class="mt-12 flex flex-wrap items-center gap-3 border-t border-beluga-200/70 pt-8"
          aria-label="Post navigation"
        >
          <a href="/blog/" class="btn-ghost">← All posts</a>
          {sourceUrl && <InstagramLink href={sourceUrl} />}
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>
