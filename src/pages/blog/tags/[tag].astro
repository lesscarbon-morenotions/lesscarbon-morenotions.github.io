---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getPublishedPosts } from '../../../utils/posts';
import { collectTags, postsWithTag } from '../../../utils/tags';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = collectTags(posts);
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, posts: postsWithTag(posts, tag.slug) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag.label}`} description={`Posts tagged ${tag.label}.`}>
  <section class="site-container py-12 sm:py-14">
    <header class="page-header">
      <p class="eyebrow">Tag</p>
      <h1>{tag.label}</h1>
      <p class="lede">
        {posts.length} post{posts.length === 1 ? '' : 's'} ·
        <a href="/blog/tags/" class="font-medium text-ink">All tags</a>
      </p>
    </header>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
