---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getPublishedPosts } from '../../../utils/posts';
import { collectTags, postsWithTag, slugifyTag } from '../../../utils/tags';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = collectTags(posts);
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, posts: postsWithTag(posts, tag.slug) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag.label}`} description={`Posts tagged ${tag.label}.`}>
  <section class="site-container py-12">
    <header class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-hydrangea-700">Tag</p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-ink">{tag.label}</h1>
      <p class="mt-2 text-muted">
        {posts.length} post{posts.length === 1 ? '' : 's'} ·
        <a href="/blog/tags/" class="text-accent">All tags</a>
      </p>
    </header>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
