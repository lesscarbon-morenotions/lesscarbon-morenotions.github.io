---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../../utils/posts';
import { collectTags } from '../../../utils/tags';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <section class="site-container py-12 sm:py-14">
    <header class="page-header">
      <p class="eyebrow">Taxonomy</p>
      <h1>Tags</h1>
      <p class="lede">Wander by theme — sustainability, nature, travel, and more.</p>
    </header>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tags.map((tag) => (
          <li>
            <a
              href={`/blog/tags/${tag.slug}/`}
              class="card flex items-center justify-between p-5 no-underline transition hover:border-moss-400/30"
            >
              <span class="font-display text-lg font-semibold text-ink">{tag.label}</span>
              <span class="rounded-full bg-moss-700/10 px-3 py-1 text-xs font-semibold text-moss-700">
                {tag.count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
