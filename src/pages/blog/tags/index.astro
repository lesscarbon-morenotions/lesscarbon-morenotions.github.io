---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../../utils/posts';
import { collectTags } from '../../../utils/tags';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <section class="site-container py-12">
    <header class="mb-8 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-hydrangea-700">Taxonomy</p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-ink">Tags</h1>
      <p class="mt-3 text-muted">Wander by theme — sustainability, books, mindfulness, and more.</p>
    </header>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tags.map((tag) => (
          <li>
            <a
              href={`/blog/tags/${tag.slug}/`}
              class="card flex items-center justify-between p-5 no-underline transition hover:border-hydrangea-300"
            >
              <span class="font-display text-lg font-semibold text-ink">{tag.label}</span>
              <span class="rounded-full bg-hydrangea-200/80 px-3 py-1 text-xs font-semibold text-hydrangea-700">
                {tag.count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
