---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstagramLink from '../components/ui/InstagramLink.astro';
import { getEntry } from 'astro:content';

const settings = await getEntry('site', 'settings');
const authorImage = settings?.data.authorImage ?? '/media/brand/author.jpg';
const instagram = settings?.data.social?.instagram ?? 'https://www.instagram.com/lesscarbon.morenotions/';
---

<BaseLayout
  title="About"
  description={settings?.data.tagline}
  image={authorImage}
>
  <article class="site-container py-12 sm:py-14">
    <div class="grid items-start gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-10">
      <div class="card overflow-hidden">
        <img
          src={authorImage}
          alt={settings?.data.author ?? 'Author'}
          class="aspect-square w-full object-cover object-center"
          width="800"
          height="800"
        />
        <div class="space-y-2 p-6">
          <p class="font-display text-xl font-semibold text-ink">
            {settings?.data.author}
          </p>
          <p class="text-sm leading-relaxed text-muted">
            {settings?.data.tagline}
          </p>
          <p class="text-sm text-ink">{settings?.data.authorBio}</p>
          <p class="text-sm text-muted">{settings?.data.authorNote}</p>
          <div class="pt-2">
            <InstagramLink href={instagram} />
          </div>
        </div>
      </div>

      <div class="glass-panel p-6 sm:p-9">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-moss-700">About</p>
        <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          {settings?.data.author}
        </h1>
        <div class="prose-nature mt-6 max-w-2xl">
          <p class="!text-lg !font-medium !text-ink">{settings?.data.tagline}</p>
          <p>{settings?.data.authorBio}</p>
          <p>{settings?.data.authorNote}</p>
          <p>
            <strong>Less Carbon, More Notions</strong> is a home for notes on living lightly —
            starting with refill-day field notes and zero-waste shops, with More Notions to come.
          </p>
          <h2>What you’ll find</h2>
          <ul>
            <li>Sustainability and everyday eco practice</li>
            <li>Refill culture and local loops</li>
            <li>Nature field notes from Instagram</li>
            <li>A calm, searchable reading layout</li>
          </ul>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary" href="/blog/">Browse posts</a>
          <InstagramLink href={instagram} />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
