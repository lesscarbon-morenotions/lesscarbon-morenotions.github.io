---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const settings = await getEntry('site', 'settings');
---

<BaseLayout
  title="About"
  description={settings?.data.authorBio}
  image="/media/brand/avatar-beluga.jpg"
>
  <article class="site-container py-14">
    <div class="grid items-start gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="card overflow-hidden">
        <img
          src="/media/brand/avatar-beluga.jpg"
          alt="Soft illustrated avatar"
          class="aspect-square w-full object-cover"
          width="480"
          height="480"
        />
        <div class="p-5">
          <p class="font-display text-xl font-semibold text-ink">{settings?.data.author}</p>
          <p class="mt-1 text-sm text-muted">{settings?.data.authorNote}</p>
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-moss-700">About</p>
        <h1 class="mt-2 font-display text-4xl font-semibold text-ink">
          Socio-ecological science & slow exploration
        </h1>
        <div class="prose-nature mt-6 max-w-2xl">
          <p>{settings?.data.authorBio}</p>
          <p>
            This site is a home for notes on living lightly — starting with refill-day field notes
            and zero-waste shops, with more notions to come.
          </p>
          <p>
            The design draws on a William Morris willow field and a cloud mark for carbon and ideas:
            a meadow you can think in.
          </p>
          <h2>What you’ll find</h2>
          <ul>
            <li>Sustainability and everyday eco practice</li>
            <li>Refill culture and local loops</li>
            <li>A calm, searchable reading layout</li>
          </ul>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary" href="/blog/">Browse posts</a>
          <a class="btn-ghost" href="/admin/">CMS panel</a>
        </div>
        <p class="mt-4 text-sm text-muted">
          Published on <strong>GitHub Pages</strong>. Editors use the local CMS
          (<code class="rounded bg-beluga-100 px-1">npm run dev</code> +
          <code class="rounded bg-beluga-100 px-1">npx decap-server</code>)
          or edit Markdown on GitHub — every push rebuilds the site.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
