---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This path wandered off into the meadow.">
  <section class="site-container py-16">
    <div class="card relative overflow-hidden">
      <img
        src="/media/nature/meadow-404.jpg"
        alt="Misty meadow of cornflowers and hydrangea"
        class="absolute inset-0 h-full w-full object-cover"
        width="1200"
        height="675"
      />
      <div class="relative bg-beluga-900/45 px-6 py-20 text-center text-white backdrop-blur-[2px] sm:px-12">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-hydrangea-200">404</p>
        <h1 class="mt-3 font-display text-4xl font-semibold sm:text-5xl">Lost in the meadow</h1>
        <p class="mx-auto mt-4 max-w-md text-beluga-100">
          This page drifted off with the butterflies. Let’s walk you back to solid ground.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="btn-primary" href="/">Home</a>
          <a class="btn-ghost !border-white/40 !bg-white/15 !text-white hover:!bg-white/25" href="/blog/">
            Blog
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
