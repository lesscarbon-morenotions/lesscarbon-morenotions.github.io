---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedPosts from '../components/home/FeaturedPosts.astro';
import { getEntry } from 'astro:content';

const settings = await getEntry('site', 'settings');
const authorImage = settings?.data.authorImage ?? '/media/brand/author.jpg';
const instagram = settings?.data.social?.instagram;
---

<BaseLayout
  title={undefined}
  description={settings?.data.description}
  image="/media/brand/og-default.jpg"
>
  <Hero />

  <section class="site-container">
    <div class="card grid gap-6 p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8">
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink">A quieter kind of progress</h2>
        <p class="mt-2 max-w-2xl text-muted">
          Starting with refill day field notes — zero-waste shops, local loops, and the joy of
          buying less packaging. More Notions will grow here over time.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="tag-pill" href="/blog/tags/sustainability/">Sustainability</a>
        <a class="tag-pill" href="/blog/tags/lifestyle/">Lifestyle</a>
      </div>
    </div>
  </section>

  <FeaturedPosts />

  <section class="site-container pb-16">
    <div class="relative overflow-hidden rounded-[2rem] border border-beluga-200 bg-white/70 p-8 md:p-12 backdrop-blur-sm">
      <div class="relative z-10 max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-moss-700">Author</p>
        <h2 class="mt-2 font-display text-3xl font-semibold text-ink">
          {settings?.data.author}
        </h2>
        <p class="mt-3 text-muted">{settings?.data.tagline}</p>
        <p class="mt-2 text-ink">{settings?.data.authorBio}</p>
        <p class="mt-1 text-muted">{settings?.data.authorNote}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/about/" class="btn-primary">About</a>
          {
            instagram && (
              <a class="btn-ghost" href={instagram} target="_blank" rel="noopener noreferrer">
                Instagram
              </a>
            )
          }
        </div>
      </div>
      <img
        src={authorImage}
        alt={settings?.data.author ?? 'Author'}
        class="pointer-events-none absolute -right-2 -bottom-4 h-44 w-44 rounded-full object-cover shadow-xl ring-4 ring-white/80 md:right-8 md:bottom-8 md:h-52 md:w-52"
        width="208"
        height="208"
        loading="lazy"
      />
    </div>
  </section>
</BaseLayout>
