---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedPosts from '../components/home/FeaturedPosts.astro';
import InstagramLink from '../components/ui/InstagramLink.astro';
import { getEntry } from 'astro:content';

const settings = await getEntry('site', 'settings');
const authorImage = settings?.data.authorImage ?? '/media/brand/author.jpg';
const instagram = settings?.data.social?.instagram ?? 'https://www.instagram.com/lesscarbon.morenotions/';
---

<BaseLayout
  title={undefined}
  description={settings?.data.description}
  image="/media/brand/og-default.jpg"
>
  <Hero />

  <section class="site-container">
    <div class="glass-panel grid gap-6 p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8">
      <div>
        <h2 class="font-display text-2xl font-semibold tracking-tight text-ink">A quieter kind of progress</h2>
        <p class="mt-2 max-w-2xl leading-relaxed text-muted">
          Refill-day field notes, wildflower meadows, and slow travel — the small practices that
          lighten our footprint. More Notions will grow here over time.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="tag-pill" href="/blog/tags/sustainability/">Sustainability</a>
        <a class="tag-pill" href="/blog/tags/nature/">Nature</a>
        <a class="tag-pill" href="/blog/tags/travel/">Travel</a>
      </div>
    </div>
  </section>

  <FeaturedPosts />

  <section class="site-container pb-16">
    <div class="glass-panel relative overflow-hidden p-8 md:p-12">
      <div class="relative z-10 max-w-xl pr-0 md:pr-40">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-moss-700">Author</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink">
          {settings?.data.author}
        </h2>
        <p class="mt-3 leading-relaxed text-muted">{settings?.data.tagline}</p>
        <p class="mt-2 text-ink">{settings?.data.authorBio}</p>
        <p class="mt-1 text-muted">{settings?.data.authorNote}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/about/" class="btn-primary">About</a>
          <InstagramLink href={instagram} />
        </div>
      </div>
      <img
        src={authorImage}
        alt={settings?.data.author ?? 'Author'}
        class="pointer-events-none absolute -right-2 bottom-4 h-36 w-36 rounded-full object-cover shadow-xl ring-4 ring-white/90 md:right-8 md:bottom-8 md:h-48 md:w-48"
        width="192"
        height="192"
        loading="lazy"
      />
    </div>
  </section>
</BaseLayout>
