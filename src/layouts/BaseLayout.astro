---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WillowBackdrop from '../components/ui/WillowBackdrop.astro';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}

const settings = await getEntry('site', 'settings');
const siteTitle = settings?.data.title ?? 'Less Carbon, more notions';
const siteDescription = settings?.data.description ?? '';

const {
  title,
  description = siteDescription,
  image = '/media/brand/og-default.jpg',
  bodyClass = '',
} = Astro.props;

const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class={`min-h-screen flex flex-col ${bodyClass}`}>
    <WillowBackdrop />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="flex-1" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>
